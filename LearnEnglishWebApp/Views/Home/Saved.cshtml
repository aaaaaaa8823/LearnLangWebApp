@{
    ViewData["Title"] = "Сохраненные";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="saved-page">
    <h1>Сохраненные уроки и тесты</h1>
    <div id="sacedContainer">
        <div class="loading">Загрузка урока...</div>
    </div>
</div>

<div class="search-wrapper">
        <input type="text"
               class="search-input"
               id="savedSearch"
               placeholder="Поиск урокам и тестам..."
               aria-label="Поиск по урокам и тестам" />
    </div>

@section Scripts {
    <link rel="stylesheet" href="~/css/saved.css" asp-append-version="true" />
    <script src="~/js/saved.js" asp-append-version="true"></script>
}