@{
    ViewData["Title"] = "Сохраненные";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="saved-page">
    <h1>Сохраненные уроки и тесты</h1>

    <div class="search-wrapper">
        <input type="text"
               class="search-input"
               id="savedSearch"
               placeholder="Поиск по сохраненным урокам и тестам..."
               aria-label="Поиск по сохраненным урокам" />
    </div>

    <div class="saved-grid" id="savedContainer">
        <div class="loading">Загрузка сохраненных уроков...</div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/saved.css" asp-append-version="true" />
    <script src="~/js/saved.js" asp-append-version="true"></script>
}