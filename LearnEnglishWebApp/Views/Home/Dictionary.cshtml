@{
    ViewData["Title"] = "Словарь";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Подключаем CSS для модального окна -->
<link rel="stylesheet" href="~/css/modal.css" asp-append-version="true" />

<div class="dictionary-page">
    <h1>Мой словарь</h1>

    <div class="stats-row">
        <div class="stat-box" onclick="showWordsModal('learning')" style="cursor: pointer;">
            <span class="stat-label">В процессе</span>
            <span class="stat-number" id="learningWords">0</span>
        </div>
        <div class="stat-box" onclick="showWordsModal('learned')" style="cursor: pointer;">
            <span class="stat-label">Выучено</span>
            <span class="stat-number" id="learnedWords">0</span>
        </div>
    </div>

    <div class="search-wrapper">
        <input type="text"
               class="search-input"
               id="wordSearch"
               placeholder="Поиск слова..."
               aria-label="Поиск по словарю" />
    </div>

    <div class="words-list" id="wordsList">
        <div class="loading">Загрузка слов...</div>
    </div>
</div>

<!-- Модальное окно -->
<div id="wordsModal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeModal()"></div>
    <div class="modal-container">
        <div class="modal-header">
            <h2 id="modalTitle">Слова в процессе</h2>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <div class="modal-body" id="modalBody">
            <div class="loading-modal">Загрузка...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dictionary.js" asp-append-version="true"></script>
}