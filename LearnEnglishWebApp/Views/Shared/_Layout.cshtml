<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LearnEnglish</title>
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dictionary.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lessons.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    @if (ViewBag.ShowSidebar == true)
    {
        <aside class="profile-sidebar">
            <div class="sidebar-header">
                <div class="user-avatar">
                    <span id="userInitials">U</span>
                </div>
                <h3 id="userName">Загрузка...</h3>
                <span class="user-level" id="userLevel">A1</span>
            </div>

            <nav class="sidebar-nav">
                <div id="userMenu">
                    <a href="/Home/Dictionary" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Dictionary" ? "active" : "")">
                        Словарь
                    </a>
                    <a href="/Home/Tests" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Tests" ? "active" : "")">
                        Тесты
                    </a>
                    <a href="/Home/Lessons" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Lessons" ? "active" : "")">
                        Уроки
                    </a>
                    <a href="/Home/Saved" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Saved" ? "active" : "")">
                        Сохраненные
                    </a>
                    <a href="/Home/Account" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Account" ? "active" : "")">
                        Настройки аккаунта
                    </a>
                </div>

                <div id="adminMenu" style="display: none;">
                    <a href="/Admin/ManageContent" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "ManageContent" ? "active" : "")">
                        Контент
                    </a>
                    <a href="/Admin/ManageUsers" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "ManageUsers" ? "active" : "")">
                        Пользователи
                    </a>
                    <a href="/Home/Account" class="nav-item">
                        Настройки аккаунта
                    </a>
                </div>
            </nav>

            <button class="logout-btn" onclick="logout()">Выйти</button>
        </aside>

        <main class="main-with-sidebar">
            @RenderBody()
        </main>
    }
    else
    {
        <main class="main-full">
            @RenderBody()
        </main>
    }

    <footer class="footer">
        <div class="footer-content">
            &copy; 2026 LearnLang — Изучай иностранные языки с удовольствием
        </div>
    </footer>

    <script src="~/js/show-data-user.js" asp-append-version="true"></script>

    @if (ViewBag.ShowSidebar == true)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof loadSidebarUser === 'function') {
                    loadSidebarUser();
                }
            });
        </script>
    }

    @if (ViewBag.ShowSidebar != true)
    {
        <script src="~/js/auth-new.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>