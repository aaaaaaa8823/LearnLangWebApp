@{
    ViewData["Title"] = "Управление тестами";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-manage-page">
    <h1>Управление тестами</h1>
    <div class="page-description">Добавление, редактирование и удаление грамматических тестов</div>

    <div id="messageArea"></div>

    <div class="list-section">
        <div class="list-header">
            <h2>Список тестов</h2>
            <span class="item-count" id="testsCount">0</span>
        </div>
        <div id="testsList">
            <div class="loading">Загрузка...</div>
        </div>
    </div>

    <div class="form-section">
        <h2 id="formTitle">Добавить новый тест</h2>
        <form id="testForm">
            <input type="hidden" id="testId" value="0">

            <div class="form-grid">
                <div class="form-group">
                    <label for="topicId">Грамматический урок *</label>
                    <select id="topicId" required>
                        <option value="">Выберите урок</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="level">Уровень *</label>
                    <select id="level" required>
                        <option value="A1">A1 - Начальный</option>
                        <option value="A2">A2 - Элементарный</option>
                        <option value="B1">B1 - Средний</option>
                        <option value="B2">B2 - Выше среднего</option>
                        <option value="C1">C1 - Продвинутый</option>
                        <option value="C2">C2 - Профессиональный</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="orderIndex">Порядковый номер</label>
                    <input type="number" id="orderIndex" value="0" min="0">
                </div>

                <div class="form-group form-group-full">
                    <label for="title">Название теста *</label>
                    <input type="text" id="title" required placeholder="Например: Present Simple - Базовый тест">
                </div>

                <div class="form-group">
                    <label for="questionCount">Количество вопросов</label>
                    <input type="number" id="questionCount" value="1" min="1" max="20">
                </div>

                <div class="form-group">
                    <label for="passingScore">Проходной балл (%)</label>
                    <input type="number" id="passingScore" value="70" min="0" max="100">
                </div>

                <div class="form-group">
                    <label for="timeLimitMinutes">Время выполнения (мин)</label>
                    <input type="number" id="timeLimitMinutes" value="10" min="0" max="120">
                </div>
            </div>

            <div class="questions-block">
                <h3>Вопросы</h3>
                <div id="questionsContainer"></div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">Сохранить</button>
                <button type="button" class="btn-cancel" onclick="resetForm()">Отмена</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="~/js/admin-test.js" asp-append-version="true"></script>
}